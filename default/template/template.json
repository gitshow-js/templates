{
    "id": "default",
    "description": "Default simple template",
    "baseTheme": "${theme}",
    "properties": {
        "theme": {
            "description": "Base Reveal.js theme",
            "default": "white"
        }
    },
    "slideClasses": [ "normal", "title", "section", "quote" ],
    "defaultClass": "normal",
    "slideModifiers": [ "centered", "fullspace" ],
    "contentClasses": [ "col", "img-right", "box", "note", "large", "small", "grey", "minus", "plus", "cite", "shadow", "r-ref", "r-refs" ],
    "styles": [ "googlecode.css" ]
}
