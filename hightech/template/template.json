{
    "id": "hightech",
    "description": "High-tech template for technical & engineering talks — light spec-sheet aesthetic",
    "properties": {
        "footer": {
            "description": "Footer text (talk title, event, or handle)",
            "default": ""
        }
    },
    "slideClasses": [ "normal", "title", "section", "quote" ],
    "defaultClass": "normal",
    "slideModifiers": [ "centered", "fullspace" ],
    "contentClasses": [ "col", "img-right", "box", "note", "large", "small", "muted", "grey", "accent", "blue", "amber", "gold", "orange", "plus", "positive", "minus", "negative", "neutral", "alert", "callout", "warning", "success", "danger", "cite", "shadow", "metric", "metric-label", "tag", "status-ok", "status-warn", "status-error" ],
    "baseTheme": "white",
    "styles": [ "hightech.css", "hightech-code.css" ],
    "usePlugins": [ "mathjax2", "rewrite", "layout" ],
    "reveal": {
        "width": 1920,
        "height": 1080,
        "margin": 0,
        "hash": true,
        "center": false,
        "transition": "fade",
        "transitionSpeed": "fast",
        "autoAnimateDuration": 0.6,
        "autoAnimateEasing": "cubic-bezier(0.4, 0, 0.2, 1)",
        "pdfMaxPagesPerSlide": 1,
        "pdfSeparateFragments": false,
        "layout": {
            "footer": {
                "numbering": true,
                "label": "${footer}"
            }
        },
        "rewrite": {
            "rules": [
                {
                    "pattern": " -- ",
                    "result": " &ndash; ",
                    "flags": "g"
                },
                {
                    "pattern": "\\.\\.\\.",
                    "result": "&hellip;",
                    "flags": "g"
                },
                {
                    "pattern": "``",
                    "result": "&bdquo;",
                    "flags": "g"
                },
                {
                    "pattern": "''",
                    "result": "&ldquo;",
                    "flags": "g"
                },
                {
                    "pattern": "@@([^@]+)@@",
                    "result": "<$1>",
                    "flags": "g"
                },
                {
                    "pattern": ">\\?\\?",
                    "result": " class=\"fragment\">",
                    "flags": "g"
                },
                {
                    "pattern": "\\|\\|([^\\|]+)\\|\\|",
                    "result": "<span class=\"fragment\">$1</span>",
                    "flags": "g"
                }
            ]
        }
    }
}
