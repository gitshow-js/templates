{
    "id": "minimal",
    "description": "Brutally minimal light template for focus-mode keynotes — one big idea per slide, enormous whitespace, a single red accent",
    "properties": {
        "footer": {
            "description": "Footer text (talk title, event, or handle)",
            "default": ""
        }
    },
    "slideClasses": [ "normal", "title", "section", "quote" ],
    "defaultClass": "normal",
    "slideModifiers": [ "centered", "fullspace" ],
    "contentClasses": [ "col", "img-right", "box", "note", "large", "small", "muted", "grey", "accent", "blue", "amber", "gold", "plus", "positive", "minus", "negative", "neutral", "callout", "warning", "success", "danger", "cite", "shadow", "metric", "metric-label", "lead", "kicker", "dot", "rule" ],
    "baseTheme": "white",
    "styles": [ "minimal.css", "minimal-code.css" ],
    "usePlugins": [ "mathjax2", "rewrite", "layout" ],
    "reveal": {
        "width": 1920,
        "height": 1080,
        "margin": 0,
        "hash": true,
        "center": false,
        "transition": "fade",
        "transitionSpeed": "slow",
        "autoAnimateDuration": 0.9,
        "autoAnimateEasing": "cubic-bezier(0.22, 1, 0.36, 1)",
        "pdfMaxPagesPerSlide": 1,
        "pdfSeparateFragments": false,
        "layout": {
            "footer": {
                "numbering": true,
                "label": "${footer}"
            }
        },
        "rewrite": {
            "rules": [
                {
                    "pattern": " -- ",
                    "result": " &ndash; ",
                    "flags": "g"
                },
                {
                    "pattern": "\\.\\.\\.",
                    "result": "&hellip;",
                    "flags": "g"
                },
                {
                    "pattern": "``",
                    "result": "&bdquo;",
                    "flags": "g"
                },
                {
                    "pattern": "''",
                    "result": "&ldquo;",
                    "flags": "g"
                },
                {
                    "pattern": "@@([^@]+)@@",
                    "result": "<$1>",
                    "flags": "g"
                },
                {
                    "pattern": ">\\?\\?",
                    "result": " class=\"fragment\">",
                    "flags": "g"
                },
                {
                    "pattern": "\\|\\|([^\\|]+)\\|\\|",
                    "result": "<span class=\"fragment\">$1</span>",
                    "flags": "g"
                }
            ]
        }
    }
}
